# Copy to .env and fill in. .env is git-ignored, never commit it.

# Loader
EXPORT_PATH=data/atlassian_jira_cloud_help_docs_export_2025-03-07.json

# Embed (OpenAI)
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Upsert (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=jira-cloud-help-docs
# Optional, defaults shown (Pinecone free plan supports aws / us-east-1)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
